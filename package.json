{
  "name": "dsh-semantic-recall",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "description": "换新对话也不失忆：跨工作区索引最近 N 天的对话，用一句模糊描述召回过去的话题与原话；不确定时会反问而不是硬编（自带设置页）",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "session", "semantic-search", "memory", "recall"],
  "license": "MIT",
  "author": "zhaohualiuyuejun",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
